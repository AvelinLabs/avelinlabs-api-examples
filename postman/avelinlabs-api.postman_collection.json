{
  "info": {
    "name": "AvelinLabs API Examples",
    "description": "Executable public-beta collection. Runtime requests use Authorization: Bearer {{avelin_api_key}}. Management tokens are used only for Platform account and key-management operations. Raw Runtime API Keys are never stored automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.avelinlabs.com"
    },
    {
      "key": "avelin_api_key",
      "value": "replace-with-your-runtime-api-key"
    },
    {
      "key": "management_token",
      "value": ""
    },
    {
      "key": "verification_token",
      "value": ""
    },
    {
      "key": "email",
      "value": "developer@example.com"
    },
    {
      "key": "password",
      "value": "ChangeMe123!"
    },
    {
      "key": "full_name",
      "value": "Alex Morgan"
    },
    {
      "key": "company_name",
      "value": "Example Company"
    },
    {
      "key": "onet_code",
      "value": "15-1252.00"
    },
    {
      "key": "source_id",
      "value": "synthetic-postman-role-criteria"
    },
    {
      "key": "trace_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{avelin_api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Platform onboarding",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/platform/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"{{full_name}}\",\n  \"company_name\": \"{{company_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/platform/verify-email?token={{verification_token}}"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });",
                  "const body = pm.response.json();",
                  "pm.test(\"Management token returned\", function () { pm.expect(body.access_token).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"management_token\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/platform/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create Runtime API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });",
                  "const body = pm.response.json();",
                  "pm.test(\"One-time Runtime API Key returned\", function () { pm.expect(body.raw_api_key).to.be.a(\"string\").and.not.empty; });",
                  "console.warn(\"Copy raw_api_key into a secure Postman environment. It is intentionally not stored automatically.\");"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{management_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/platform/api-keys/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-local-development\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
